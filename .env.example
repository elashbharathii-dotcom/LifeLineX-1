# ==============================================================================
# LIFELINEX ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.development, .env.staging, or .env.production
# NEVER COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# ─── PUBLIC CLIENT VARIABLES (Exposed in browser bundle) ──────────────────────
# Application Environment (development | staging | production)
VITE_APP_ENV=staging

# Supabase Project URL (HTTPS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Client Key (Public JWT with RLS enforcement)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Public Base URL (Used for Google OAuth redirect callbacks)
VITE_APP_URL=http://localhost:5173

# Leaflet Map Tile Server URL (Optional override)
VITE_MAP_TILE_SERVER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Google Maps JavaScript API Key (Development Map Provider)
# Enable: Maps JavaScript API, Geocoding API, Directions API
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-placeholder

# ─── PRIVATE SERVER / EDGE FUNCTION SECRETS (NEVER IN CLIENT CODE) ────────────
# Set these exclusively in Supabase Dashboard -> Edge Functions -> Secrets
# OR via: supabase secrets set <NAME>=<VALUE>

# Supabase Service Role Key (Bypasses RLS - Admin operations only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# SMS Gateway (Twilio / MSG91 / Fast2SMS) for Emergency Alerts & OTP
# SMS_GATEWAY_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=AC_placeholder
# TWILIO_AUTH_TOKEN=placeholder
# SMS_SENDER_ID=LIFELX

# Email Notification Gateway (SendGrid / AWS SES / Resend)
# EMAIL_API_KEY=placeholder
# EMAIL_FROM_ADDRESS=alerts@lifelinex.health

# UIDAI Aadhaar Verification Service (Partner / AUA)
# UIDAI_AUA_API_KEY=placeholder
# UIDAI_AUA_ENDPOINT=https://aua.uidai.gov.in/auth
